# Supabase Credentials (from your Supabase project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL for metadata & OG cards
NEXT_PUBLIC_SITE_URL=https://veerstudios.com

# Instagram & WhatsApp Integration
NEXT_PUBLIC_WHATSAPP_NUMBER=+919876543210
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/veer.studios

# Razorpay Online Payment Gateway (Optional - COD is supported out of the box)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
